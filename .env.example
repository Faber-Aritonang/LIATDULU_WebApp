# Environment Variables Configuration
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# ============================================
# REQUIRED VARIABLES
# ============================================

# Bynara Router API Key
# Get from: https://bynara.id/
BYNARA_API_KEY=

# NextAuth Secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# NextAuth URL
# Your production domain
NEXTAUTH_URL=https://liatdulu.vercel.app

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# VERCEL SERVICES
# ============================================

# Vercel Postgres Connection String
# Format: postgres://user:password@host:port/database
POSTGRES_URL=

# Vercel KV REST API
KV_REST_API_URL=https://your-workspace.kv.vercel-storage.com
KV_REST_API_TOKEN=

# Vercel Blob Read/Write Token
BLOB_READ_WRITE_TOKEN=

# ============================================
# OPTIONAL EMAIL CONFIGURATION (for Magic Link)
# ============================================

# Email Server Configuration
# EMAIL_SERVER_HOST=smtp.example.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your-email@example.com
# EMAIL_SERVER_PASSWORD=your-email-password
# EMAIL_FROM=noreply@yourdomain.com

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Rate Limiting (defaults will be used if not set)
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW=3600

# Application Settings
# DEBUG=false
# NODE_ENV=production